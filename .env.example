# ============================================================
# Clyptus Job Portal - Platform Super Admin Environment Configuration
# ============================================================

# Server & Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clyptus_recruitment?schema=public"

# Redis (Caching, Rate Limiting, Distributed Locking)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars-long"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN="7d"
COOKIE_SECRET="super-secret-cookie-secret-key-replace-in-production"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Background Worker (BullMQ)
BULLMQ_REDIS_URL="redis://localhost:6379"

# Payment Gateways (Billing & Token Purchases)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Cloud Storage (AWS S3 or Cloudflare R2 for Platform Assets)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="clyptus-platform-assets"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="s3_access_key_placeholder"
STORAGE_SECRET_KEY="s3_secret_key_placeholder"
STORAGE_ENDPOINT="" # Leave empty for AWS S3, set for Cloudflare R2 / MinIO

# Email Service (Platform Notifications & Alerts)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="no-reply@clyptus.platform"

# Search Engine (OpenSearch / Elasticsearch)
OPENSEARCH_NODE="http://localhost:9200"
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""

# AI Engine (Google Gemini API for Candidate Matching & Platform Insights)
GEMINI_API_KEY=""

# Observability & Monitoring
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
PROMETHEUS_METRICS_PATH="/metrics"
